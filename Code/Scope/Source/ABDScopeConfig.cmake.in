@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Canonical targets (ABDShared::Scope*). Consumers must link ABDShared::ScopeCore
# or ABDShared::ScopeCoreHeaders; legacy ABDScope::* aliases were removed in the
# Fase 4 consolidation.
if(NOT TARGET ABDShared::ScopeCoreHeaders)
  add_library(ABDShared::ScopeCoreHeaders INTERFACE IMPORTED)
  set_target_properties(ABDShared::ScopeCoreHeaders PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES
      "${PACKAGE_PREFIX_DIR}/include/abd/scope/Core"
  )
  target_compile_definitions(ABDShared::ScopeCoreHeaders INTERFACE ABD_SCOPE_EXPORTS)
endif()

if(NOT TARGET ABDShared::ScopeCore)
  add_library(ABDShared::ScopeCore INTERFACE IMPORTED)
  set_target_properties(ABDShared::ScopeCore PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES
      "${PACKAGE_PREFIX_DIR}/include/abd/scope/Core"
      "${PACKAGE_PREFIX_DIR}/include/abd/scope/JUCE"
  )

  if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    set_target_properties(ABDShared::ScopeCore PROPERTIES
      INTERFACE_COMPILE_OPTIONS "/MD"
    )
  else()
    set_target_properties(ABDShared::ScopeCore PROPERTIES
      INTERFACE_COMPILE_OPTIONS "-fPIC"
    )
  endif()

  target_compile_definitions(ABDShared::ScopeCore INTERFACE ABD_SCOPE_EXPORTS)
endif()