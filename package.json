    "./components/*": "./Components/*",
    "./icons/*": "./Assets/icons/*",
    "./assets/*": "./Assets/*",
    "./utils": "./Utils/index.js",
    "./utils/*": "./Utils/*"
  },
  "files": [
    "Code",
    "Contracts",
    "Components",
    "Assets",
    "Utils",
    "docs"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
