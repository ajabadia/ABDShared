{
  "name": "@abdsynths/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Núcleo universal transversal para la suite ABDSynths: C++, contratos, componentes WebUI y assets.",
  "exports": {
    "./styles": "./Assets/styles/index.css",
    "./styles/*": "./Assets/styles/*",
    "./themes/*": "./Assets/styles/themes/*",
    "./contracts/*": "./Contracts/*",
